# =============================================================================
# Flask 基础配置
# =============================================================================

# 必须设置！使用以下命令生成随机串：
#   python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your-secret-key-here

# 本地敏感操作确认密码（导出、查看账号密码、WebDAV 配置等）
# 网站登录已改由 Pocket ID 负责；此值不再用于登录网站。
LOGIN_PASSWORD=change-this-sensitive-action-password

# =============================================================================
# Pocket ID OIDC 登录（必填）
# =============================================================================
POCKET_ID_URL=https://sso.jackyccc.com
POCKET_ID_CLIENT_ID=your-pocket-id-client-id
POCKET_ID_CLIENT_SECRET=your-pocket-id-client-secret
# 必须与 Pocket ID OIDC Client 中登记的 Callback URL 完全一致
POCKET_ID_REDIRECT_URI=https://your-outlook-domain.example.com/auth/pocket-id/callback
POCKET_ID_SCOPES=openid profile email

# HTTPS 生产部署应保持为 true；仅本地 HTTP 调试时改为 false
SESSION_COOKIE_SECURE=true

# =============================================================================
# 应用运行时
# =============================================================================
PORT=5000
HOST=0.0.0.0
FLASK_ENV=production

# 全局日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL（默认 INFO）
# 默认 INFO 会输出出站 [代理] 详情（拉信 / Token 刷新 / 自动授权；密码已打码）
# 批量刷新或生产环境觉得吵时，设为 WARNING 可降噪关闭 [代理] 与大部分 INFO 日志
# LOG_LEVEL=WARNING

# 数据库路径
DATABASE_PATH=data/outlook_accounts.db

# IMAP 超时（秒）
IMAP_TIMEOUT=45

# 邮件列表整体获取超时（秒），也可在系统设置中调整
MAIL_FETCH_OVERALL_TIMEOUT=120

# =============================================================================
# 临时邮箱服务
# =============================================================================
GPTMAIL_BASE_URL=https://mail.chatgpt.org.uk
GPTMAIL_API_KEY=gpt-test

DUCKMAIL_BASE_URL=https://api.duckmail.sbs
DUCKMAIL_API_KEY=

# =============================================================================
# OAuth2 配置（可选，不填使用默认值）
# =============================================================================
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_REDIRECT_URI=http://localhost:8080

# =============================================================================
# Docker 自更新（可选，仅 Docker 部署时使用）
# =============================================================================
# 启用后需要将宿主 Docker socket 挂载到容器：
#   - /var/run/docker.sock:/var/run/docker.sock
# DOCKER_UPDATE_ENABLED=true
# DOCKER_UPDATE_CONTAINER=outlook-mail
